   "source": [
    "#structure the data for unique observations\n",
    "# index = the unique key for one observation (a crop, in a country, in a year)\n",
    "# columns = the Element (Area harvested / Yield / Production) becomes its own column\n",
    "# values = the numeric Value for that element\n",
    "pivot = df.pivot_table(\n",
    "    index=['Area', 'Item', 'Year'],\n",
    "    columns='Element',\n",
    "    values='Value',\n",
    "    aggfunc='first'\n",
    ").reset_index()\n",
    "\n",
    "pivot.columns.name = None \n",
    "\n",
    "pivot = pivot.rename(columns={\n",
    "    'Area harvested': 'Area_Harvested_ha',\n",
    "    'Yield': 'Yield_kg_ha',\n",
    "    'Production': 'Production_tons'\n",
    "})\n",
    "\n",
    "pivot.head()\n"
   ]
  },
