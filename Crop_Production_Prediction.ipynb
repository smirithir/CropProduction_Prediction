    "GROUP BY Area\n",
    "ORDER BY Total_Production DESC\n",
    "LIMIT 10;\n",
    "'''\n",
    "top_countries_sql = pd.read_sql_query(query_top_countries, conn)\n",
    "top_countries_sql\n"
   ]
