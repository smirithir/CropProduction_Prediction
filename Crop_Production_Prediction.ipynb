   "source": [
    "# SQL: Top 10 crops by total global production (summed across all countries & years)\n",
    "query_top_crops = '''\n",
    "SELECT Item, ROUND(SUM(Production_tons), 0) AS Total_Production\n",
    "FROM crops\n",
    "GROUP BY Item\n",
    "ORDER BY Total_Production DESC\n",
    "LIMIT 10;\n",
    "'''\n",
    "top_crops_sql = pd.read_sql_query(query_top_crops, conn)\n",
    "top_crops_sql\n"
   ]
  },
