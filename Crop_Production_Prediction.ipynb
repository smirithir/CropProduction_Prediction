   "source": [
    "# Growth analysis: which crops grew the most in total production from 2019 to 2023?\n",
    "prod_2019 = clean[clean['Year'] == 2019].groupby('Item')['Production_tons'].sum()\n",
    "prod_2023 = clean[clean['Year'] == 2023].groupby('Item')['Production_tons'].sum()\n",
    "\n",
    "growth = pd.DataFrame({'2019': prod_2019, '2023': prod_2023}).dropna()\n",
    "growth['Growth_%'] = ((growth['2023'] - growth['2019']) / growth['2019']) * 100\n",
    "growth_sorted = growth.sort_values('Growth_%', ascending=False)\n",
    "\n",
    "print(\"Top 10 fastest-growing crops (by total production, 2019 -> 2023):\")\n",
    "growth_sorted.head(10)\n"
   ]
  },
