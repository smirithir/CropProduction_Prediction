    "# SQL: Highest-yielding crops on average (kg/ha) -- efficiency view\n",
    "query_high_yield = '''\n",
    "SELECT Item, ROUND(AVG(Yield_kg_ha), 1) AS Avg_Yield_kg_ha\n",
    "FROM crops\n",
    "GROUP BY Item\n",
    "ORDER BY Avg_Yield_kg_ha DESC\n",
    "LIMIT 10;\n",
    "'''\n",
    "high_yield_sql = pd.read_sql_query(query_high_yield, conn)\n",
    "high_yield_sql\n"
   ]
