   "source": [
    "# drop rows with any missing measurement (can't use an incomplete record for regression)\n",
    "clean = pivot.dropna(subset=['Area_Harvested_ha', 'Yield_kg_ha', 'Production_tons']).copy()\n",
    "\n",
    "# remove non-physical values (0 or negative doesn't make sense for these quantities)\n",
    "clean = clean[\n",
    "    (clean['Area_Harvested_ha'] > 0) &\n",
    "    (clean['Yield_kg_ha'] > 0) &\n",
    "    (clean['Production_tons'] > 0)\n",
    "]\n",
    "\n",
    "print(f\"Rows before cleaning: {pivot.shape[0]:,}\")\n",
    "print(f\"Rows after cleaning:  {clean.shape[0]:,}\")\n",
    "print(f\"Unique crops (Item):  {clean['Item'].nunique()}\")\n",
    "print(f\"Unique countries/areas: {clean['Area'].nunique()}\")\n",
    "print(f\"Year range: {clean['Year'].min()} - {clean['Year'].max()}\")\n",
    "\n",
    "clean.head()\n"
   ]
  },
