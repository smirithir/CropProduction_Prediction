   "source": [
    "# SQL: Year-over-year global totals (Area harvested, Production) -- detect overall trend\n",
    "query_yearly = '''\n",
    "SELECT Year,\n",
    "       ROUND(SUM(Area_Harvested_ha), 0) AS Total_Area_Harvested,\n",
    "       ROUND(SUM(Production_tons), 0)   AS Total_Production,\n",
    "       ROUND(AVG(Yield_kg_ha), 1)       AS Avg_Yield\n",
    "FROM crops\n",
    "GROUP BY Year\n",
    "ORDER BY Year;\n",
    "'''\n",
    "yearly_sql = pd.read_sql_query(query_yearly, conn)\n",
    "yearly_sql\n"
   ]
  },
