   "source": [
    "def flag_outliers(group):\n",
    "    q1, q3 = group.quantile(0.25), group.quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "    lower, upper = q1 - 1.5 * iqr, q3 + 1.5 * iqr\n",
    "    return (group < lower) | (group > upper)\n",
    "\n",
    "clean['Is_Outlier'] = clean.groupby('Item')['Production_tons'].transform(flag_outliers)\n",
    "\n",
    "print(f\"Flagged {clean['Is_Outlier'].sum():,} rows ({clean['Is_Outlier'].mean()*100:.1f}%) as statistical outliers within their crop group.\")\n",
    "print(\"These are KEPT in the dataset (they're plausible real-world extremes, e.g. major producers), just flagged for awareness.\")\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "top5_crops = clean['Item'].value_counts().head(5).index\n",
    "sns.boxplot(data=clean[clean['Item'].isin(top5_crops)], x='Item', y='Production_tons', hue='Item', palette='Set2', legend=False)\n",
    "plt.yscale('log')\n",
    "plt.title('Production Distribution & Outliers for Top 5 Most-Recorded Crops (log scale)')\n",
    "plt.xticks(rotation=20)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
