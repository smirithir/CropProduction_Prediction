   "source": [
    "# Load the cleaned DataFrame into an in-memory SQLite database as a table called \"crops\"\n",
    "conn = sqlite3.connect(\":memory:\")\n",
    "clean.to_sql(\"crops\", conn, index=False, if_exists=\"replace\")\n",
    "print(\"Loaded into SQLite table 'crops'\")\n"
   ]
